# ---------------------------------------------------------------------------
# // Snip — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Neon PostgreSQL pooled connection string.
# Neon dashboard -> Connect -> Pooled connection. Keep `sslmode=require`.
NEON_DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require

# Google OAuth 2.0 web client.
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match an "Authorized redirect URI" in Google Cloud Console exactly.
# The app's callback route is always: /api/auth/callback/google
# Local development (npm run dev defaults to port 3000):
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
# Production / Vercel (replace the domain, keep the path):
# GOOGLE_REDIRECT_URI=https://your-app.vercel.app/api/auth/callback/google

# Recommended: dedicated signing key for session JWTs and visitor hashes.
# Generate one with: openssl rand -base64 32
# If omitted, GOOGLE_CLIENT_SECRET is used as the fallback.
AUTH_SECRET=

# Optional: public origin used when generating short links.
# Leave empty on Vercel; the app derives the origin from request headers.
# Set it for a custom domain, e.g. https://snip.example.com
APP_URL=
